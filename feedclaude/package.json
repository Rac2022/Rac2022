{
  "name": "feedclaude",
  "version": "1.0.0",
  "description": "Feed Claude tacos and burritos instead of waving a wand",
  "license": "MIT",
  "main": "main.js",
  "bin": {
    "feedclaude": "bin/feedclaude.js"
  },
  "os": [
    "darwin",
    "win32"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "electron",
    "tray",
    "overlay",
    "cli",
    "encouragement",
    "claude",
    "taco",
    "burrito",
    "food"
  ],
  "files": [
    "main.js",
    "preload.js",
    "overlay.html",
    "sounds",
    "icon",
    "bin/feedclaude.js",
    "README.md"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "npm pack",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.feedclaude.app",
    "productName": "FeedClaude",
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "icon/**/*",
      "sounds/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
